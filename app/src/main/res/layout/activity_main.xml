<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    tools:context=".MainActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000" />

    <TextView
        android:id="@+id/game_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:text="@string/android"
        android:textColor="#FFD700"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 模式选择面板 -->
    <LinearLayout
        android:id="@+id/mode_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game_title"
        app:layout_constraintVertical_bias="0.3">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_single_player"
            android:layout_width="240dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:text="单人模式"
            android:textSize="18sp"
            app:cornerRadius="32dp"
            app:backgroundTint="#4CAF50"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_multi_player"
            android:layout_width="240dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:text="联机对战"
            android:textSize="18sp"
            app:cornerRadius="32dp"
            app:backgroundTint="#FF9800"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rank"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="240dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:text="排行榜"
            android:textColor="#FFFFFF"
            app:strokeColor="#FFFFFF"
            app:cornerRadius="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_profile"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="240dp"
            android:layout_height="64dp"
            android:text="个人档案"
            android:textColor="#FFFFFF"
            app:strokeColor="#FFFFFF"
            app:cornerRadius="32dp" />
    </LinearLayout>

    <!-- 难度选择面板 (初始隐藏) -->
    <LinearLayout
        android:id="@+id/difficulty_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game_title"
        app:layout_constraintVertical_bias="0.3">

        <TextView
            android:id="@+id/tv_mode_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="模式：单人模式"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_easy"
            android:layout_width="240dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:text="@string/easy1"
            app:cornerRadius="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_normal"
            android:layout_width="240dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:text="@string/normal"
            app:cornerRadius="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_hard"
            android:layout_width="240dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:text="@string/hard"
            app:cornerRadius="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_to_mode"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回模式选择"
            android:textColor="#AAAAAA" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:background="#80000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/music"
            android:textColor="#FFFFFF" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>